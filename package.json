{
  "name": "nyayasetu",
  "version": "0.1.0",
  "private": true,
  "description": "NyayaSetu (LexSynq) — Indian LegalTech SaaS on Convex + Next.js.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:convex",
    "dev:web": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "setup:auth": "node scripts/setup-auth.mjs",
    "e2e": "node e2e.mjs",
    "check": "npm run typecheck && npm run typecheck:convex && npm test && next build"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.87",
    "convex": "^1.17.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.35",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

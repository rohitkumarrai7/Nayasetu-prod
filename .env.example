# ─── Frontend (Next.js / Vercel) ─────────────────────────────────────────────
# Your Convex deployment's cloud URL (Convex dashboard → Settings → URL & Deploy Key).
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
# Used by the Convex CLI to target your deployment:
CONVEX_DEPLOYMENT=dev:YOUR-DEPLOYMENT

# ─── Backend secrets (set on CONVEX, not here) ───────────────────────────────
# Convex functions read these from the deployment's own env. Set them with:
#   npx convex env set GROQ_API_KEY   <key>     # primary LLM (OpenAI-compatible, no training)
#   npx convex env set GEMINI_API_KEY <key>     # embeddings + optional LLM (needs an AIza… key)
#   npx convex env set GROQ_MODEL     openai/gpt-oss-120b         # optional override (auto-falls back if retired)
#   npx convex env set GEMINI_MODEL   gemini-2.0-flash            # optional override
#   npx convex env set GEMINI_ALLOW_PRIVILEGED true   # only if GEMINI_API_KEY is a paid/no-train key
#
# With NO keys set, the service still runs: retrieval uses a deterministic embedder and
# generation uses a grounded offline fallback (never fabricates).
